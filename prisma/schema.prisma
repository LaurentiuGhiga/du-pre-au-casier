generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  stripeId  String   @unique
  email     String
  amount    Int
  status    String   @default("paid")
  createdAt DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id       String @id @default(cuid())
  name     String
  price    Int
  quantity Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  priceInfo   String?
  image       String
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  producerId String?
  producer   Producer? @relation(fields: [producerId], references: [id])
}

model Producer {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  email       String?
  phone       String?
  location    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}
