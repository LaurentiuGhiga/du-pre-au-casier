generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  stripeId  String   @unique
  email     String
  amount    Int
  status String @default("paid")
  createdAt DateTime @default(now())
  

  items     OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  name      String
  price     Int
  quantity  Int

  orderId   String
  order     Order @relation(fields: [orderId], references: [id])
}